{
  "name": "openplay-backend",
  "version": "0.0.1",
  "private": true,
  "description": "OpenPlay shared backend API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:lint": "tsx scripts/db-lint.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "nest start --watch",
    "keys:generate": "tsx scripts/dev-keys.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/main",
    "test": "jest",
    "token:dev": "tsx scripts/dev-token.ts",
    "worker:dev": "nest start --watch --entryFile worker"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "nestjs-cls": "^5.4.3",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqids": "^0.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
