DOCKER_CONTAINER_PREFIX=openplay
BACKEND_PORT=8000
POSTGRES_DB=openplay
POSTGRES_USER=openplay
POSTGRES_PASSWORD=local-development-only
# Admin/migration connection used by the npm utility container (migrate, seed).
DATABASE_URL=postgresql://openplay:local-development-only@postgres:5432/openplay?connection_limit=10&pool_timeout=20
# Application runtime connection — the openplay_app non-superuser role that RLS binds.
OPENPLAY_APP_PASSWORD=local-development-only
APP_DATABASE_URL=postgresql://openplay_app:local-development-only@postgres:5432/openplay?connection_limit=10&pool_timeout=20
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
SEED_DEMO=false
PLATFORM_ADMIN_PASSWORD=demo-pass-123
# JWT signing (see api-security model): iam issues RS256 from JWT_PRIVATE_KEY;
# other components verify with JWT_PUBLIC_KEY only. JWT_SECRET is the local-only
# HS256 fallback and must not back service-to-service auth.
# Generate a dev pair: docker compose run --rm npm run keys:generate
JWT_ISSUER=openplay-identity-access
JWT_AUDIENCE=openplay-api
JWT_TTL=900
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=
# Optional per-scope SQID alphabets: SQID_ALPHABET, or SQID_ALPHABET_<SCOPE>
#SQID_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
# Optional AI profile: containerized Ollama, or a host-installed Ollama on macOS (http://host.docker.internal:11434)
OLLAMA_HOST=http://ollama:11434
# Encrypts BYOK provider keys before they reach Postgres; generate a 32-byte base64 key
AI_PROVIDER_ENCRYPTION_KEY=
# Notifications profile (reminder worker → Mailpit)
MAIL_FROM=openplay@local.test
REMINDER_SCAN_INTERVAL_MS=5000

# Redis (JWT blacklist) — optional; absence falls back to expiry-only validation
REDIS_URL=redis://redis:6379
